# Postgres connection string. With Supabase, use the transaction pooler URL
# (Project Settings -> Database -> Connection string -> Transaction pooler).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# First admin account, created automatically when the users table is empty.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Admin

# Optional: protects the nightly backup endpoint (/api/cron/backup).
# Vercel Cron sends this automatically as a Bearer token when set.
CRON_SECRET=

# Optional: enables AI-written call scripts and emails. Without it, the
# templates in Settings are filled in with the lead's data instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
